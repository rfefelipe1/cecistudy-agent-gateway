# Variáveis do gateway. Copie para `.env` e preencha; nunca commite o `.env`.
#
# No Render estas seis são pedidas pelo `render.yaml` (as marcadas `sync: false`):
#   DATABASE_URL · DATABASE_AUTH_TOKEN · NIM_API_KEYS ·
#   GATEWAY_SESSION_SECRET · AGENT_APP_KEY · ADMIN_PASSWORD
# O resto tem default no código e não precisa ser preenchido lá.

# Porta HTTP. O Render injeta a dele automaticamente.
PORT=10000

# Banco (libSQL/Turso).
# Dev/teste: arquivo local. Produção: URL do Turso — o disco do Render Free é
# efêmero e `file:` lá perde jobs e aparelhos a cada deploy.
# Onde pegar: app.turso.tech → seu banco → "URL" e "Create token".
DATABASE_URL=file:./data/gateway.db
DATABASE_AUTH_TOKEN=

# Chave(s) da NVIDIA NIM, separadas por vírgula (rotação/fallback).
# Nunca vai para o app. Onde pegar: build.nvidia.com → perfil → API Keys.
NIM_API_KEYS=
NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NIM_BASE_URL=https://integrate.api.nvidia.com
NIM_TIMEOUT_MS=60000
NIM_MAX_ATTEMPTS_PER_KEY=2

# Segredo que assina o JWT de sessão. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GATEWAY_SESSION_SECRET=

# Chave que o app envia em X-App-Key ao abrir sessão.
# Precisa ser **idêntica** a `VITE_AGENT_GATEWAY_APP_KEY` no build do app.
# Vai no bundle: é barreira de uso casual, não segredo.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
AGENT_APP_KEY=

# Senha do painel em /admin. Você escolhe.
ADMIN_PASSWORD=

# Tempos de vida e limites (padrões já servem).
SESSION_TTL_SECONDS=43200
ADMIN_TTL_SECONDS=3600
SESSIONS_PER_MINUTE_PER_IP=10
ADMIN_PER_MINUTE_PER_IP=5
JOBS_PER_MINUTE_PER_DEVICE=6
MAX_BODY_BYTES=262144
